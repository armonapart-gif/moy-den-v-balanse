{
 "sources": [
  {
   "id": "part1",
   "offsetSec": 0.0,
   "durationSec": 61.617
  },
  {
   "id": "part2",
   "offsetSec": 61.617,
   "durationSec": 45.852
  },
  {
   "id": "part3",
   "offsetSec": 107.468,
   "durationSec": 80.682
  }
 ],
 "totalSec": 188.15,
 "phrases": [
  {
   "n": 1,
   "file": "part1",
   "local": [
    1.0,
    6.39
   ],
   "global": [
    1.0,
    6.39
   ],
   "text": "Доброе утро, друзья! Как дела у вас? Ой, как я люблю арбузы! Уже дождь, уже прохладно, [НЕРАЗБОРЧИВО: 1–2 слова], но арбузы ещё сладкие.",
   "tag": "?"
  },
  {
   "n": 2,
   "file": "part1",
   "local": [
    9.4,
    11.47
   ],
   "global": [
    9.4,
    11.47
   ],
   "text": "Наверное, это самая лучшая еда для человека.",
   "tag": ""
  },
  {
   "n": 3,
   "file": "part1",
   "local": [
    14.16,
    16.57
   ],
   "global": [
    14.16,
    16.57
   ],
   "text": "И влага, и глюкоза, и минералы.",
   "tag": "?"
  },
  {
   "n": 4,
   "file": "part1",
   "local": [
    19.72,
    20.97
   ],
   "global": [
    19.72,
    20.97
   ],
   "text": "Я обещала вам сегодня вебинар.",
   "tag": ""
  },
  {
   "n": 5,
   "file": "part1",
   "local": [
    21.67,
    22.4
   ],
   "global": [
    21.67,
    22.4
   ],
   "text": "Но, к сожалению,",
   "tag": ""
  },
  {
   "n": 6,
   "file": "part1",
   "local": [
    23.39,
    26.29
   ],
   "global": [
    23.39,
    26.29
   ],
   "text": "у меня планы поменялись. Я решила сделать мини-продукт.",
   "tag": ""
  },
  {
   "n": 7,
   "file": "part1",
   "local": [
    28.43,
    31.39
   ],
   "global": [
    28.43,
    31.39
   ],
   "text": "И поэтому [поменяла свой контент-план?]",
   "tag": "?"
  },
  {
   "n": 8,
   "file": "part1",
   "local": [
    38.75,
    41.04
   ],
   "global": [
    38.75,
    41.04
   ],
   "text": "Я поняла одну вещь за много лет:",
   "tag": ""
  },
  {
   "n": 9,
   "file": "part1",
   "local": [
    42.32,
    46.4
   ],
   "global": [
    42.32,
    46.4
   ],
   "text": "в онлайне, в офлайне у нас нет проблем, потому что у нас есть тренера,",
   "tag": ""
  },
  {
   "n": 10,
   "file": "part1",
   "local": [
    46.96,
    48.81
   ],
   "global": [
    46.96,
    48.81
   ],
   "text": "у нас занятия, у нас кафе,",
   "tag": ""
  },
  {
   "n": 11,
   "file": "part1",
   "local": [
    49.24,
    52.13
   ],
   "global": [
    49.24,
    52.13
   ],
   "text": "у нас сообщество, женщины видят друг друга,",
   "tag": ""
  },
  {
   "n": 12,
   "file": "part1",
   "local": [
    53.28,
    55.66
   ],
   "global": [
    53.28,
    55.66
   ],
   "text": "кто получил результат. Новенькие приходят, видят",
   "tag": ""
  },
  {
   "n": 13,
   "file": "part1",
   "local": [
    56.56,
    60.6
   ],
   "global": [
    56.56,
    60.6
   ],
   "text": "тех женщин, которые уже получили результат. Для них это такая поддержка.",
   "tag": ""
  },
  {
   "n": 14,
   "file": "part1",
   "local": [
    60.8,
    61.62
   ],
   "global": [
    60.8,
    61.62
   ],
   "text": "[обрыв файла: «да… ну… в…»]",
   "tag": "GAP"
  },
  {
   "n": 15,
   "file": "part2",
   "local": [
    0.56,
    3.66
   ],
   "global": [
    62.18,
    65.28
   ],
   "text": "…потому что считают, что это сложно.",
   "tag": "GAP"
  },
  {
   "n": 16,
   "file": "part2",
   "local": [
    5.84,
    6.37
   ],
   "global": [
    67.46,
    67.98
   ],
   "text": "Поэтому",
   "tag": ""
  },
  {
   "n": 17,
   "file": "part2",
   "local": [
    7.2,
    8.14
   ],
   "global": [
    68.82,
    69.76
   ],
   "text": "для тех, кто…",
   "tag": ""
  },
  {
   "n": 18,
   "file": "part2",
   "local": [
    8.84,
    9.44
   ],
   "global": [
    70.46,
    71.06
   ],
   "text": "[НЕРАЗБОРЧИВО]",
   "tag": "UNCLEAR"
  },
  {
   "n": 19,
   "file": "part2",
   "local": [
    11.24,
    15.32
   ],
   "global": [
    72.86,
    76.94
   ],
   "text": "Для тех, кто вот сомневается, я решила сделать мини-продукт.",
   "tag": ""
  },
  {
   "n": 20,
   "file": "part2",
   "local": [
    15.32,
    18.91
   ],
   "global": [
    76.94,
    80.52
   ],
   "text": "Он будет немного стоить. К сожалению, не могу вам бесплатно это дать.",
   "tag": ""
  },
  {
   "n": 21,
   "file": "part2",
   "local": [
    19.08,
    20.17
   ],
   "global": [
    80.7,
    81.79
   ],
   "text": "Бесплатно ничего не ценится.",
   "tag": ""
  },
  {
   "n": 22,
   "file": "part2",
   "local": [
    20.82,
    23.07
   ],
   "global": [
    82.44,
    84.69
   ],
   "text": "Такой мини-продукт — неделя со мной",
   "tag": ""
  },
  {
   "n": 23,
   "file": "part2",
   "local": [
    24.18,
    26.61
   ],
   "global": [
    85.8,
    88.23
   ],
   "text": "с питанием, с йогой,",
   "tag": ""
  },
  {
   "n": 24,
   "file": "part2",
   "local": [
    27.78,
    31.34
   ],
   "global": [
    89.4,
    92.95
   ],
   "text": "с информацией. Даже йогу для лица вместе будем делать, да?",
   "tag": ""
  },
  {
   "n": 25,
   "file": "part2",
   "local": [
    31.62,
    37.16
   ],
   "global": [
    93.24,
    98.78
   ],
   "text": "Неделю вы со мной потихоньку, по шагам перестраиваете свой рацион, свою жизнь,",
   "tag": ""
  },
  {
   "n": 26,
   "file": "part2",
   "local": [
    37.22,
    40.5
   ],
   "global": [
    98.84,
    102.12
   ],
   "text": "какие-то свои привычки — ровно настолько, насколько вам комфортно,",
   "tag": ""
  },
  {
   "n": 27,
   "file": "part2",
   "local": [
    41.06,
    42.51
   ],
   "global": [
    102.68,
    104.13
   ],
   "text": "да? Согласны?",
   "tag": ""
  },
  {
   "n": 28,
   "file": "part2",
   "local": [
    43.04,
    45.85
   ],
   "global": [
    104.66,
    107.47
   ],
   "text": "Давайте об этом поговорим эту неделю.",
   "tag": ""
  },
  {
   "n": 29,
   "file": "part3",
   "local": [
    0.72,
    8.08
   ],
   "global": [
    108.19,
    115.55
   ],
   "text": "И вот на передаче мы с ней как раз поговорили. Я ей звонила с передачи, она рассказывала — говорит: «Прекрасно себя чувствую,",
   "tag": "GAP"
  },
  {
   "n": 30,
   "file": "part3",
   "local": [
    8.8,
    12.97
   ],
   "global": [
    116.27,
    120.44
   ],
   "text": "уже намного легче». Она знает, что просто надо начать генеральную уборку.",
   "tag": ""
  },
  {
   "n": 31,
   "file": "part3",
   "local": [
    13.52,
    18.08
   ],
   "global": [
    120.99,
    125.55
   ],
   "text": "Я хочу назвать свой продукт «Генеральная уборка». Как вам такое название?",
   "tag": ""
  },
  {
   "n": 32,
   "file": "part3",
   "local": [
    18.32,
    21.1
   ],
   "global": [
    125.79,
    128.57
   ],
   "text": "Или «Пять дней лёгкости со мной», да?",
   "tag": ""
  },
  {
   "n": 33,
   "file": "part3",
   "local": [
    22.72,
    23.63
   ],
   "global": [
    130.19,
    131.09
   ],
   "text": "Что-то вот…",
   "tag": ""
  },
  {
   "n": 34,
   "file": "part3",
   "local": [
    24.36,
    28.52
   ],
   "global": [
    131.83,
    135.99
   ],
   "text": "«Пять дней лёгкости с Зебунисо» или «Генеральная уборка с Зебунисо», да.",
   "tag": ""
  },
  {
   "n": 35,
   "file": "part3",
   "local": [
    28.52,
    32.18
   ],
   "global": [
    135.99,
    139.65
   ],
   "text": "Вот что-то такое [хочу / хотя?] придумать, чтобы вы пришли и почувствовали,",
   "tag": "?"
  },
  {
   "n": 36,
   "file": "part3",
   "local": [
    32.92,
    36.4
   ],
   "global": [
    140.39,
    143.86
   ],
   "text": "потому что никто не верит, что через три дня совсем другие ощущения.",
   "tag": ""
  },
  {
   "n": 37,
   "file": "part3",
   "local": [
    36.96,
    37.18
   ],
   "global": [
    144.43,
    144.64
   ],
   "text": "Честно.",
   "tag": ""
  },
  {
   "n": 38,
   "file": "part3",
   "local": [
    37.92,
    42.16
   ],
   "global": [
    145.39,
    149.63
   ],
   "text": "А вот эти пять–семь дней со мной — вот сколько надо, на сколько вас хватит.",
   "tag": ""
  },
  {
   "n": 39,
   "file": "part3",
   "local": [
    42.16,
    46.15
   ],
   "global": [
    149.63,
    153.62
   ],
   "text": "Я думаю, вы смогли бы это почувствовать. Так что давайте, жду вас.",
   "tag": ""
  },
  {
   "n": 40,
   "file": "part3",
   "local": [
    47.85,
    51.15
   ],
   "global": [
    155.32,
    158.62
   ],
   "text": "Если всё-таки кто-то хочет вебинар, мы можем его организовать.",
   "tag": ""
  },
  {
   "n": 41,
   "file": "part3",
   "local": [
    52.17,
    55.18
   ],
   "global": [
    159.64,
    162.65
   ],
   "text": "Напишите «да» — вебинар, кто хочет вебинар.",
   "tag": ""
  },
  {
   "n": 42,
   "file": "part3",
   "local": [
    55.53,
    57.95
   ],
   "global": [
    163.0,
    165.42
   ],
   "text": "Да, ну я думаю, что давайте лучше хорошенько подготовимся —",
   "tag": ""
  },
  {
   "n": 43,
   "file": "part3",
   "local": [
    58.61,
    60.98
   ],
   "global": [
    166.08,
    168.45
   ],
   "text": "на вебинаре я ещё подробно буду рассказывать.",
   "tag": ""
  },
  {
   "n": 44,
   "file": "part3",
   "local": [
    61.38,
    64.58
   ],
   "global": [
    168.85,
    172.05
   ],
   "text": "И всё-таки я хочу, чтобы вы пришли сюда с какой-то темой,",
   "tag": ""
  },
  {
   "n": 45,
   "file": "part3",
   "local": [
    64.58,
    66.78
   ],
   "global": [
    172.05,
    174.25
   ],
   "text": "да, может быть, головные боли.",
   "tag": ""
  },
  {
   "n": 46,
   "file": "part3",
   "local": [
    66.78,
    69.82
   ],
   "global": [
    174.25,
    177.29
   ],
   "text": "Да вот, для головных болей генеральная уборка точно нужна.",
   "tag": "NR"
  },
  {
   "n": 47,
   "file": "part3",
   "local": [
    69.86,
    71.3
   ],
   "global": [
    177.33,
    178.77
   ],
   "text": "Так что жду вас.",
   "tag": ""
  },
  {
   "n": 48,
   "file": "part3",
   "local": [
    72.42,
    73.59
   ],
   "global": [
    179.89,
    181.06
   ],
   "text": "До встречи и…",
   "tag": ""
  },
  {
   "n": 49,
   "file": "part3",
   "local": [
    75.34,
    76.47
   ],
   "global": [
    182.81,
    183.94
   ],
   "text": "встретимся на вебинаре.",
   "tag": ""
  },
  {
   "n": 50,
   "file": "part3",
   "local": [
    77.42,
    78.39
   ],
   "global": [
    184.89,
    185.86
   ],
   "text": "Пишите слово «голова».",
   "tag": ""
  }
 ]
}